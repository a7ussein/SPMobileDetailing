---
import { business, navLinks } from "@/lib/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-surface)]">
  <div
    class="container-page section grid gap-10 !py-14 md:grid-cols-[1.4fr_1fr_1fr_1fr]"
  >
    <div>
      <div class="flex items-center gap-3">
        <img
          src="/sp-logo.png"
          alt="SP Detailing logo"
          class="h-14 w-auto object-contain"
          loading="lazy"
        />
      </div>
      <p class="mt-4 text-sm leading-relaxed text-[var(--color-ink-muted)]">
        Mobile detailing for Maine drivers who want the clean car without losing
        the day.
      </p>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-wider">
        Service Area
      </p>
      <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-muted)]">
        {business.serviceArea}
      </p>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-wider">Contact</p>
      <div class="mt-3 space-y-1.5 text-sm text-[var(--color-ink-muted)]">
        <a
          href={business.phoneHref}
          class="block transition-colors hover:text-[var(--color-ink)]"
        >
          {business.phone}
        </a>
        <a
          href={business.emailHref}
          class="block transition-colors hover:text-[var(--color-ink)]"
        >
          {business.email}
        </a>
        <a
          href={business.instagramHref}
          class="block transition-colors hover:text-[var(--color-ink)]"
        >
          {business.instagram}
        </a>
      </div>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-wider">Hours</p>
      <p class="mt-3 text-sm text-[var(--color-ink-muted)]">
        {business.hours}
      </p>
      <nav
        class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm"
        aria-label="Footer"
      >
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>

  <div
    class="container-page flex flex-col items-start justify-between gap-2 border-t border-[var(--color-border)] py-6 text-sm text-[var(--color-ink-muted)] md:flex-row md:items-center"
  >
    <p>&copy; {year} {business.name}. All rights reserved.</p>
    <p>
      Owned and operated in Maine by {business.owner}. · Powered by <a
        href="https://automyte.dev"
        class="text-[var(--color-accent)] underline underline-offset-4 hover:text-[var(--color-accent-hover)]"
        >automyte</a
      >
    </p>
  </div>
</footer>
