---
interface Props {
  headline: string;
  sub?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { headline, sub, ctaLabel = "Get in touch", ctaHref = "/contact" } = Astro.props;
---

<section class="section bg-[var(--color-ink)] text-[var(--color-bg)]">
  <div class="container-page grid items-center gap-8 md:grid-cols-[2fr_1fr]">
    <div>
      <h2 class="max-w-[20ch] text-[var(--color-bg)]">{headline}</h2>
      {sub && <p class="mt-4 max-w-prose text-lg opacity-80">{sub}</p>}
    </div>
    <div class="flex md:justify-end">
      <a
        href={ctaHref}
        class="inline-flex items-center gap-2 rounded-md bg-[var(--color-bg)] px-6 py-3.5 font-medium text-[var(--color-ink)] transition-transform hover:-translate-y-0.5"
      >
        {ctaLabel} &nbsp;→
      </a>
    </div>
  </div>
</section>
