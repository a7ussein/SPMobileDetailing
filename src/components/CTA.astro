---
interface Props {
  headline: string;
  sub?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  headline,
  sub,
  ctaLabel = "Get in touch",
  ctaHref = "/contact",
} = Astro.props;
---

<section class="section">
  <div class="container-page">
    <div
      class="relative mx-auto max-w-3xl overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] px-8 py-16 text-center md:px-16"
    >
      <!-- Accent glow -->
      <div
        class="pointer-events-none absolute -top-20 left-1/2 h-40 w-80 -translate-x-1/2 rounded-full bg-[var(--color-accent)] opacity-[0.06] blur-[80px]"
        aria-hidden="true"
      >
      </div>

      <p class="eyebrow mb-5">Book the detail</p>
      <h2 class="mx-auto max-w-[20ch]">{headline}</h2>
      {
        sub && (
          <p class="mx-auto mt-5 max-w-prose text-lg text-[var(--color-ink-muted)]">
            {sub}
          </p>
        )
      }
      <div class="mt-10">
        <a href={ctaHref} class="btn-primary">{ctaLabel}</a>
      </div>
    </div>
  </div>
</section>
