---
interface Service {
  title: string;
  description: string;
}

interface Props {
  heading: string;
  intro?: string;
  services: Service[];
}

const { heading, intro, services } = Astro.props;
---

<section class="section border-t border-[var(--color-border)]">
  <div class="container-page">
    <div class="max-w-2xl">
      <h2>{heading}</h2>
      {intro && <p class="mt-4 text-lg text-[var(--color-ink-muted)]">{intro}</p>}
    </div>

    <!-- Deliberately asymmetric: first item is bigger. Avoids AI-slop
         "three identical cards" pattern. -->
    <div class="mt-12 grid gap-8 md:grid-cols-6">
      {
        services.map((service, i) => (
          <article
            class:list={[
              "flex flex-col border-t border-[var(--color-border)] pt-6",
              i === 0 ? "md:col-span-3 md:row-span-2" : "md:col-span-3",
            ]}
          >
            <h3 class="text-xl font-semibold">{service.title}</h3>
            <p class="mt-3 text-[var(--color-ink-muted)]">{service.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
