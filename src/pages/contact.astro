---
import Base from "@/layouts/Base.astro";
import { business } from "@/lib/site";
import ContactForm from "@/components/ContactForm";
---

<Base
  title={`Contact — ${business.name}`}
  description={`Call, email, or message ${business.name} to book mobile car detailing in Maine.`}
>
  <section class="section pt-32">
    <div class="container-page grid gap-12 md:grid-cols-[1fr_1.2fr]">
      <div>
        <p class="eyebrow mb-6">Get in touch</p>
        <h1>Contact us.</h1>
        <p class="mt-6 text-lg text-[var(--color-ink-muted)]">
          Have a question about our services or need a custom quote? Send us a
          message and Ahmad will get back to you shortly.
        </p>

        <dl class="mt-10 grid gap-6">
          <div>
            <dt class="text-sm font-semibold uppercase tracking-wider">
              Service area
            </dt>
            <dd class="mt-1.5 text-[var(--color-ink-muted)]">
              {business.serviceArea}
            </dd>
          </div>
          <div>
            <dt class="text-sm font-semibold uppercase tracking-wider">
              Hours
            </dt>
            <dd class="mt-1.5 text-[var(--color-ink-muted)]">
              {business.hours}
            </dd>
          </div>
          <div>
            <dt class="text-sm font-semibold uppercase tracking-wider">
              Call / Text
            </dt>
            <dd class="mt-1.5">
              <a
                class="text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-accent)]"
                href={business.phoneHref}>{business.phone}</a
              >
            </dd>
          </div>
          <div>
            <dt class="text-sm font-semibold uppercase tracking-wider">
              Email
            </dt>
            <dd class="mt-1.5">
              <a
                class="text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-accent)]"
                href={business.emailHref}>{business.email}</a
              >
            </dd>
          </div>
          <div>
            <dt class="text-sm font-semibold uppercase tracking-wider">
              Instagram
            </dt>
            <dd class="mt-1.5">
              <a
                class="text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-accent)]"
                href={business.instagramHref}>{business.instagram}</a
              >
            </dd>
          </div>
        </dl>
      </div>

      <div class="card p-7 md:p-8">
        <h2 class="mb-6 text-2xl font-semibold !not-italic">Send a message</h2>
        <ContactForm client:load />
      </div>
    </div>
  </section>
</Base>
