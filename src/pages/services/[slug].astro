---
import type { InferGetStaticPropsType } from "astro";
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import CTA from "@/components/CTA.astro";
import { business } from "@/lib/site";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { service } = Astro.props as Props;
const { Content } = await render(service);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.data.title,
  provider: {
    "@type": "LocalBusiness",
    name: business.name,
    telephone: business.phone,
  },
  description: service.data.description,
  areaServed: {
    "@type": "State",
    name: "Maine",
  },
  url: Astro.site
    ? new URL(Astro.url.pathname, Astro.site).toString()
    : Astro.url.href,
};
---

<Base
  title={`${service.data.title} — ${business.name}`}
  description={service.data.description}
  jsonLd={serviceSchema}
>
  <section class="section pt-32 bg-[var(--color-surface)]">
    <div class="container-page max-w-3xl text-center">
      <p class="eyebrow mb-6">Service</p>
      <h1>{service.data.title}</h1>
      <p class="mx-auto mt-6 text-xl text-[var(--color-ink-muted)]">
        {service.data.description}
      </p>

      {
        (service.data.price || service.data.duration) && (
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4 text-sm font-semibold uppercase tracking-wider">
            {service.data.price && (
              <span class="rounded-sm border border-[var(--color-border)] bg-[var(--color-surface-raised)] px-4 py-2 text-[var(--color-accent)]">
                {service.data.price}
              </span>
            )}
            {service.data.duration && (
              <span class="rounded-sm border border-[var(--color-border)] bg-[var(--color-surface-raised)] px-4 py-2 text-[var(--color-ink-muted)]">
                {service.data.duration}
              </span>
            )}
          </div>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container-page max-w-3xl">
      <div class="prose prose-invert prose-lg max-w-none [&_p]:text-[var(--color-ink-muted)] [&_h2]:font-display [&_h2]:italic [&_h2]:text-[var(--color-ink)] [&_h3]:text-[var(--color-ink)] [&_strong]:text-[var(--color-ink)] [&_li]:text-[var(--color-ink-muted)]">
        <Content />
      </div>

      <div class="mt-16 text-center">
        <a href="/book" class="btn-primary">Book this service</a>
      </div>
    </div>
  </section>

  <CTA
    headline="Not sure what your car needs?"
    sub="Contact Ahmad and describe your vehicle's condition to get a custom recommendation."
    ctaLabel="Get in touch"
    ctaHref="/contact"
  />
</Base>
