---
import "@/styles/global.css";
import AdminDashboard from "@/components/AdminDashboard";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin — SP Mobile Detailing</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-[var(--color-bg)]">
    <div
      class="mx-auto w-full max-w-4xl px-4 py-6 sm:px-6 sm:py-10"
    >
      <header class="mb-8 flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5">
          <img
            src="/sp-logo.png"
            alt="SP Detailing"
            class="h-10 w-auto object-contain"
          />
          <div>
            <p
              class="font-display text-lg font-medium italic text-[var(--color-ink)]"
            >
              SP Detailing
            </p>
            <p
              class="text-xs font-bold tracking-wider uppercase text-[var(--color-ink-muted)]"
            >
              Admin Dashboard
            </p>
          </div>
        </a>
      </header>

      <AdminDashboard client:load />
    </div>
  </body>
</html>
